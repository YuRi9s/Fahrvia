DATABASE_URL=postgresql://fleet:replace-with-private-password@localhost:5432/fleet
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
# A private service that sends password-reset and staff-invitation templates. HTTPS in production.
AUTH_EMAIL_WEBHOOK_URL=
AUTH_EMAIL_WEBHOOK_TOKEN=
# Private object bucket; public bucket access must be disabled.
S3_BUCKET=
AWS_REGION=eu-central-1
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Absolute executable path, e.g. /usr/bin/clamscan. Required for production PDFs.
MALWARE_SCANNER=
# One-time bootstrap only; remove these values after seeding.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
SEED_ORGANIZATION=

# Local invitation testing only. Set to manual to show one-time test links.
# Production requires email (the default), HTTPS and the email webhook above.
INVITATION_DELIVERY=email
