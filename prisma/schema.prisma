generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  twoFactorEnabled Boolean @default(false)
  sessions Session[]
  accounts Account[]
  memberships Membership[]
  twoFactor TwoFactor?
}
model Session {
  mfaVerified Boolean @default(false)
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model TwoFactor {
  verified Boolean @default(true)
  failedVerificationCount Int @default(0)
  lockedUntil DateTime?
  id String @id
  secret String
  backupCodes String
  userId String @unique
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model RateLimit {
  id String @id
  key String @unique
  count Int
  lastRequest BigInt
}
model Organization {
  id String @id @default(uuid())
  name String
  timezone String @default("Europe/Berlin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
}
model Membership {
  notificationActions Notification[] @relation("NotificationOwner")
  stockAlertItems InventoryItem[] @relation("InventoryAlertRecipient")
  id String @id @default(uuid())
  organizationId String
  organization Organization @relation(fields:[organizationId],references:[id])
  userId String
  user User @relation(fields:[userId],references:[id])
  role String @default("DRIVER")
  active Boolean @default(true)
  version Int @default(1)
  driver DriverProfile?
  @@unique([userId,organizationId])
  @@unique([id,organizationId])
}
model DriverProfile {
  id String @id @default(uuid())
  organizationId String
  membershipId String? @unique
  membership Membership? @relation(fields:[membershipId,organizationId],references:[id,organizationId])
  firstName String
  lastName String
  email String
  phone String @default("")
  transporterId String?
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inventoryCustody InventoryCustody[]
  waveParticipants WaveParticipant[]
  assignments VehicleAssignment[]
  scores DriverScore[]
  times WorkTimeEntry[]
  @@unique([id,organizationId])
  @@unique([membershipId,organizationId])
  @@unique([organizationId,email])
  @@unique([organizationId,transporterId])
  @@index([organizationId,status,lastName])
}
model Category {
  id String @id @default(uuid())
  organizationId String
  type String
  name String
  status String @default("ACTIVE")
  version Int @default(1)
  createdAt DateTime @default(now())
  brandVehicles Vehicle[] @relation("VehicleBrand")
  providerVehicles Vehicle[] @relation("VehicleProvider")
  @@unique([organizationId,type,name])
  @@unique([id,organizationId])
}

model Vehicle {
  id String @id @default(uuid())
  organizationId String
  plate String
  vin String
  brandCategoryId String?
  brandCategory Category? @relation("VehicleBrand", fields:[brandCategoryId,organizationId], references:[id,organizationId], onDelete: Restrict)
  providerCategoryId String?
  providerCategory Category? @relation("VehicleProvider", fields:[providerCategoryId,organizationId], references:[id,organizationId], onDelete: Restrict)
  brand String
  model String
  year Int
  ownership String
  provider String?
  status String @default("ACTIVE")
  inFleet DateTime @db.Date
  deFleet DateTime? @db.Date
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  inventoryCustody InventoryCustody[]
  waveParticipants WaveParticipant[]
  assignments VehicleAssignment[]
  keys VehicleKey[]
  periods VehicleServicePeriod[]
  photos VehiclePhotoReport[]
  @@unique([id,organizationId])
  @@unique([organizationId,plate])
  @@unique([organizationId,vin])
  @@index([organizationId,status,plate])
  @@index([brandCategoryId])
  @@index([providerCategoryId])
}
model VehicleServicePeriod {
  id String @id @default(uuid())
  organizationId String
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId,organizationId],references:[id,organizationId])
  startAt DateTime @db.Date
  endAt DateTime? @db.Date
}
model VehicleAssignment {
  id String @id @default(uuid())
  organizationId String
  vehicleId String
  driverId String
  vehicle Vehicle @relation(fields:[vehicleId,organizationId],references:[id,organizationId])
  driver DriverProfile @relation(fields:[driverId,organizationId],references:[id,organizationId])
  startAt DateTime @default(now())
  endAt DateTime?
  createdBy String
  closedBy String?
  @@index([organizationId,startAt])
}
model VehicleKey {
  id String @id @default(uuid())
  organizationId String
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId,organizationId],references:[id,organizationId])
  status String @default("ACTIVE")
  version Int @default(1)
  replacesKeyId String? @unique
  slot Int
  location String @default("OFFICE")
  driverId String?
  updatedAt DateTime @updatedAt
  custody KeyCustody[]
  @@index([vehicleId,slot])
  @@unique([id,organizationId])
  @@index([organizationId])
}
model KeyCustody {
  id String @id @default(uuid())
  organizationId String
  keyId String
  key VehicleKey @relation(fields:[keyId],references:[id])
  location String
  driverId String?
  actorId String
  action String @default("TRANSFER")
  reason String @default("")
  createdAt DateTime @default(now())
  @@index([keyId,createdAt])
}
model StoredObject {
  id String @id @default(uuid())
  organizationId String
  key String @unique
  filename String
  mime String
  size Int
  status String @default("QUARANTINED")
  driverId String?
  vehicleId String?
  createdBy String
  createdAt DateTime @default(now())
  documents Document[]
  photos VehiclePhoto[]
  @@index([organizationId])
}
model VehiclePhotoReport {
  id String @id @default(uuid())
  organizationId String
  vehicleId String
  vehicle Vehicle @relation(fields:[vehicleId,organizationId],references:[id,organizationId])
  reporterId String
  reporterName String
  notes String @default("")
  damage Boolean @default(false)
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  files VehiclePhoto[]
  @@index([organizationId,createdAt])
}
model VehiclePhoto {
  id String @id @default(uuid())
  reportId String
  report VehiclePhotoReport @relation(fields:[reportId],references:[id])
  objectId String
  object StoredObject @relation(fields:[objectId],references:[id])
}
model Document {
  driverVisible Boolean @default(false)
  id String @id @default(uuid())
  organizationId String
  title String
  driverId String?
  vehicleId String?
  expiresAt DateTime? @db.Date
  objectId String
  object StoredObject @relation(fields:[objectId],references:[id])
  replacesId String?
  archivedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId,expiresAt])
}
model ScoreImport {
  sourceKey String?
  sourceHash String?
  id String @id @default(uuid())
  organizationId String
  week String
  filename String
  hash String
  mapping Json
  rows Json
  errors Json
  status String @default("DRAFT")
  createdBy String
  createdAt DateTime @default(now())
  committedAt DateTime?
  previousId String?
  scores DriverScore[]
  @@index([organizationId,week,status])
}
model DriverScore {
  id String @id @default(uuid())
  organizationId String
  importId String
  source ScoreImport @relation(fields:[importId],references:[id])
  driverId String
  driver DriverProfile @relation(fields:[driverId,organizationId],references:[id,organizationId])
  week String
  totalScore Decimal? @db.Decimal(12,4)
  rank Int?
  packages Int?
  bonus Decimal? @db.Decimal(12,2)
  focusArea String?
  status String?
  metrics Json
  @@unique([importId,driverId])
  @@index([organizationId,driverId,week])
}
model DeliveryDetail {
  id String @id @default(uuid())
  organizationId String
  driverId String
  week String
  kind String
  date DateTime @db.Date
  intendedLocation String?
  actualLocation String?
  category String?
  notes String?
  sourceReference String @default("Nicht dokumentiert (Altbestand)")
  sourceMethod String @default("MANUAL")
  createdAt DateTime @default(now())
  createdBy String?
  revision Int @default(1)
  previousId String? @unique
  isCurrent Boolean @default(true)
  correctionReason String?
  @@index([organizationId,driverId,week])
}
model PlanEvent {
  id String @id @default(uuid())
  organizationId String
  title String
  startAt DateTime
  endAt DateTime
  driverId String?
  vehicleId String?
  notes String @default("")
  deletedAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId,startAt])
}
model Wave {
  version Int @default(1)
  participants WaveParticipant[]
  driverId String?
  vehicleId String?
  id String @id @default(uuid())
  organizationId String
  name String
  startAt DateTime
  packages Int @default(0)
  delivered Int @default(0)
  status String @default("PLANNED")
  createdAt DateTime @default(now())
  @@index([organizationId,startAt])
  @@unique([id,organizationId])
}
model WorkTimeEntry {
  version Int @default(1)
  id String @id @default(uuid())
  organizationId String
  driverId String
  driver DriverProfile @relation(fields:[driverId,organizationId],references:[id,organizationId])
  startAt DateTime
  endAt DateTime?
  breakMinutes Int @default(0)
  status String @default("OPEN")
  approvedBy String?
  approvedAt DateTime?
  updatedAt DateTime @updatedAt
  revisions WorkTimeRevision[]
  @@index([organizationId,driverId,startAt])
}
model WorkTimeRevision {
  id String @id @default(uuid())
  entryId String
  entry WorkTimeEntry @relation(fields:[entryId],references:[id])
  before Json
  actorId String
  reason String
  createdAt DateTime @default(now())
}
model InventoryItem {
  alertRecipientId String?
  alertRecipient Membership? @relation("InventoryAlertRecipient",fields:[alertRecipientId,organizationId],references:[userId,organizationId],onDelete:Restrict)
  alertVersion Int @default(1)
  lowStockActive Boolean @default(false)
  lowStockEpisode Int @default(0)
  stockNotifications Notification[]
  id String @id @default(uuid())
  organizationId String
  name String
  sku String
  category String @default("")
  stock Int @default(0)
  minimumStock Int @default(0)
  location String @default("")
  updatedAt DateTime @updatedAt
  custody InventoryCustody[]
  movements InventoryMovement[]
  @@unique([id,organizationId])
  @@unique([organizationId,sku])
}
model InventoryMovement {
  type String @default("ADJUST")
  custodyId String?
  custody InventoryCustody? @relation(fields:[custodyId,itemId],references:[id,itemId])
  id String @id @default(uuid())
  itemId String
  item InventoryItem @relation(fields:[itemId],references:[id])
  quantity Int
  reason String
  actorId String
  createdAt DateTime @default(now())
  @@index([itemId,createdAt,id])
}
model Message {
  threadId String?
  id String @id @default(uuid())
  organizationId String
  senderId String
  recipientId String
  subject String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId,recipientId,createdAt])
  @@index([organizationId,senderId,createdAt])
}
model Notification {
  version Int @default(1)
  staffOnly Boolean @default(false)
  actionOwnerId String?
  actionOwner Membership? @relation("NotificationOwner",fields:[actionOwnerId,organizationId],references:[userId,organizationId],onDelete:Restrict)
  nextAction String @default("")
  dueAt DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  outcome String @default("")
  nextReminderAt DateTime? @default(dbgenerated("(CURRENT_TIMESTAMP + '24 hours'::interval)"))
  deliveryStatus String @default("PENDING")
  deliveryAttempts Int @default(0)
  lastDeliveryError String?
  reminderOfId String?
  reminderOf Notification? @relation("Reminder",fields:[reminderOfId,organizationId],references:[id,organizationId],onDelete:Restrict)
  reminders Notification[] @relation("Reminder")
  stockItemId String?
  stockItem InventoryItem? @relation(fields:[stockItemId,organizationId],references:[id,organizationId],onDelete:Restrict)
  resolvedAt DateTime?
  id String @id @default(uuid())
  organizationId String
  recipientId String
  title String
  body String
  readAt DateTime?
  createdAt DateTime @default(now())
  @@index([organizationId,recipientId,readAt])
  @@index([stockItemId,resolvedAt])
  @@unique([id,organizationId])
  @@index([organizationId,actionOwnerId])
  @@index([nextReminderAt])
}
model AuditLog {
  id String @id @default(uuid())
  organizationId String
  actorId String
  action String
  resourceType String
  resourceId String
  details Json?
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
}
model SecurityEvent {
  organizationId String?
  resourceId String?
  details Json?
  @@index([organizationId,createdAt])
  id String @id @default(uuid())
  requestId String
  actorId String?
  kind String
  createdAt DateTime @default(now())
}

model Invitation {
  id String @id @default(uuid())
  organizationId String
  email String
  name String
  role String
  driverId String?
  tokenHash String @unique
  status String @default("PENDING")
  delivery String @default("PENDING")
  mode String
  expiresAt DateTime
  createdBy String
  issuerVersion Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSentAt DateTime
  acceptedAt DateTime?
  acceptedUserId String?
  @@index([organizationId,createdAt])
}

model WaveParticipant {
  id String @id @default(uuid())
  organizationId String
  waveId String
  driverId String?
  vehicleId String?
  wave Wave @relation(fields:[waveId,organizationId],references:[id,organizationId],onDelete:Cascade)
  driver DriverProfile? @relation(fields:[driverId,organizationId],references:[id,organizationId])
  vehicle Vehicle? @relation(fields:[vehicleId,organizationId],references:[id,organizationId])
  @@unique([waveId,driverId])
  @@unique([waveId,vehicleId])
  @@index([organizationId,driverId])
  @@index([organizationId,vehicleId])
}

model InventoryCustody {
  id String @id @default(uuid())
  organizationId String
  itemId String
  item InventoryItem @relation(fields:[itemId,organizationId],references:[id,organizationId])
  driverId String?
  driver DriverProfile? @relation(fields:[driverId,organizationId],references:[id,organizationId])
  vehicleId String?
  vehicle Vehicle? @relation(fields:[vehicleId,organizationId],references:[id,organizationId])
  quantity Int
  returned Int @default(0)
  version Int @default(1)
  requestId String
  reason String
  issuedBy String
  issuedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  movements InventoryMovement[]
  @@unique([organizationId,requestId])
  @@unique([id,itemId])
  @@index([organizationId,itemId,issuedAt])
}
